# Copy this file to .env. Keep exactly one environment block uncommented.
# To switch environments, comment the active block and uncomment the target block.

# Shared defaults (override inside the active block when needed)
REFRESH_TOKEN_TTL_DAYS=7
ACCESS_TOKEN_TTL_MIN=15
PRE_AUTH_TOKEN_TTL_MIN=5
TWOFA_ISSUER=ROPA
PUBLIC_PORT=8080
PUBLIC_HTTPS_PORT=8443
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# local (active)
# -----------------------------------------------------------------------------
APP_ENV=local
POSTGRES_USER=ropa
POSTGRES_PASSWORD=ropa
POSTGRES_DB=ropa
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5433
# DATABASE_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=5173
BACKEND_ORIGIN=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
PUBLIC_ORIGIN=https://localhost:8443
ACCESS_TOKEN_SECRET=change-this-to-a-long-random-string
PRE_AUTH_TOKEN_SECRET=change-this-to-a-different-long-random-string
# Keep this value stable after users enroll in 2FA; rotating it requires re-enrollment.
TOTP_ENCRYPTION_KEY=change-this-to-a-64-char-hex-string
ADMIN_EMAIL=admin@ropa.local
ADMIN_PASSWORD=ChangeMe123!

# -----------------------------------------------------------------------------
# qa (inactive)
