# Copy to .env and adjust before running `docker compose up`

POSTGRES_USER=ropa
POSTGRES_PASSWORD=ropa
POSTGRES_DB=ropa
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5433

# Used when env:setup generates backend/.env and frontend/.env.
# Set DATABASE_URL to override the URL derived from the PostgreSQL values above.
# DATABASE_URL=postgresql://user:password@host:5432/database?schema=public
BACKEND_PORT=4000
FRONTEND_PORT=5173
BACKEND_ORIGIN=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Long random string used to sign JWT access tokens
ACCESS_TOKEN_SECRET=change-this-to-a-long-random-string

REFRESH_TOKEN_TTL_DAYS=7
ACCESS_TOKEN_TTL_MIN=15

# Separate secret for the short-lived pre-2FA session (never reuse ACCESS_TOKEN_SECRET)
PRE_AUTH_TOKEN_SECRET=change-this-to-a-different-long-random-string
PRE_AUTH_TOKEN_TTL_MIN=5

# 32-byte hex key used to encrypt TOTP secrets at rest. Generate with:
#   openssl rand -hex 32
TOTP_ENCRYPTION_KEY=change-this-to-a-64-char-hex-string

# Issuer name shown in authenticator apps (Google Authenticator, Authy, ...)
TWOFA_ISSUER=ROPA

# Public URL the app will be served on (used for CORS). The app always
# serves HTTPS with a self-signed certificate generated on first boot —
# browsers will show a certificate warning until you swap in a real one.
PUBLIC_ORIGIN=https://localhost:8443
PUBLIC_PORT=8080
PUBLIC_HTTPS_PORT=8443

# Bootstrap super-admin account created on first run
ADMIN_EMAIL=admin@ropa.local
ADMIN_PASSWORD=ChangeMe123!

# Where ROPA record attachments are stored on disk (bind-mount this as a
# volume in production so uploads survive container recreation)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
