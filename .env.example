# PRE_AUTH_TOKEN_SECRET=change-this-to-a-unique-prod-pre-auth-secret
# TOTP_ENCRYPTION_KEY=replace-with-prod-totp-key
# ADMIN_EMAIL=admin@ropa.example
# ADMIN_PASSWORD=change-this-prod-admin-password

# Optional: use a complete connection URL instead of the POSTGRES_* values.
# DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# Generate secrets before using any environment:
#   openssl rand -base64 48  # ACCESS_TOKEN_SECRET
#   openssl rand -base64 48  # PRE_AUTH_TOKEN_SECRET
#   openssl rand -hex 32     # TOTP_ENCRYPTION_KEY
