{
  "name": "ai-vibe-ropa",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.5.1",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "turbo run build",
