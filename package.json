  },
  "overrides": {
    "cookie": "^0.7.2",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true
  }
