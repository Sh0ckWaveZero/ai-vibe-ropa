{
  "name": "ai-vibe-ropa",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev --ui=tui",
    "dev:stream": "turbo run dev --ui=stream --log-prefix=task",
    "env:setup": "node scripts/setup-env.mjs",
    "test": "node --test scripts/setup-env.test.mjs && turbo run test",
    "prisma:generate": "turbo run prisma:generate",
    "prisma:migrate": "turbo run prisma:migrate",
    "seed": "turbo run seed"
  },
  "devDependencies": {
    "turbo": "^2.10.9"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@prisma/client@7.9.1": true,
    "fsevents": false,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true
  }
}
