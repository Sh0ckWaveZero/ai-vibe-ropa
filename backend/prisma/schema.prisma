generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  th
  en
  zh
}

enum RopaStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  nameTh    String
  nameEn    String
  nameZh    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  ropaRecords RopaRecord[]

  @@map("departments")
}

model Role {
  id        String   @id @default(uuid())
  code      String   @unique
  nameTh    String
  nameEn    String
  nameZh    String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id            String @id @default(uuid())
  code          String @unique
  module        String
  action        String
  descriptionTh String
  descriptionEn String
  descriptionZh String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  roleId       String
  departmentId String?
  localePref   Locale    @default(th)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Two-factor authentication (TOTP) — mandatory for every account.
  totpSecretEnc String?  @map("totp_secret_enc")
  totpEnabled   Boolean  @default(false) @map("totp_enabled")

  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  refreshTokens    RefreshToken[]
  backupCodes      BackupCode[]
  auditLogs        AuditLog[]
  createdRecords   RopaRecord[]   @relation("RopaCreatedBy")
  updatedRecords   RopaRecord[]   @relation("RopaUpdatedBy")
  approvedRecords  RopaRecord[]   @relation("RopaApprovedBy")

  @@map("users")
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("backup_codes")
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model RopaRecord {
  id           String     @id @default(uuid())
  referenceNo  String     @unique
  departmentId String
  status       RopaStatus @default(DRAFT)

  activityName    String
  purpose         String
  legalBasis      String
  controllerName  String
  jointController String?

  dataSubjectCategories   String[]
  dataCategories          String[]
  sensitiveDataCategories String[]
  collectionSource        String
  recipients              String[]

  hasCrossBorderTransfer Boolean @default(false)
  crossBorderDestination String?
  crossBorderSafeguards  String?

  retentionPeriod String
  disposalMethod  String
  securityMeasures String
  dpoContact      String?
  remarks         String?

  createdById String
  updatedById String?
  approvedById String?

  submittedAt      DateTime?
  approvedAt       DateTime?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  createdBy  User       @relation("RopaCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?      @relation("RopaUpdatedBy", fields: [updatedById], references: [id])
  approvedBy User?      @relation("RopaApprovedBy", fields: [approvedById], references: [id])

  @@map("ropa_records")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([createdAt])
}
